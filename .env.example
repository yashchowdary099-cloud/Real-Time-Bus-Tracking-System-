# ==============================================================================
# REAL-TIME BUS TRACKING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' or export these environment variables in your terminal/IDE.
# Never commit credentials or passwords to version control.

# Server Port
SERVER_PORT=8080

# Active Spring Profile: 'mysql' for production MySQL, 'h2' for standalone memory DB
SPRING_PROFILES_ACTIVE=mysql

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bus_tracking_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# JPA & Hibernate Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# GPS Simulation Settings
SIMULATION_ENABLED=true
SIMULATION_INTERVAL_MS=2000
